// IDE layout: broot tree sidebar (left) + main pane + console (bottom).
// New tab in current session: `zide` | whole session: zellij --layout ide
// Variants: ide-git (lazygit right), ide-llm (claude right).
layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="20%" name="tree" command="broot" {
                close_on_exit true
            }
            pane split_direction="horizontal" {
                pane focus=true name="editor"
                pane size="25%" name="console"
            }
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}

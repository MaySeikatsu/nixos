// IDE layout: yazi tree sidebar (left) + main pane + console (bottom).
// Reveal-in-editor: press `o` inside yazi -> file opens in the editor pane
// via the zellij-reveal-file script (see modules/home-manager/cli/zellij.nix).
// New tab in current session: `zide` | whole session: zellij --layout ide
// Variants: ide-git (lazygit right), ide-llm (claude right).
layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="22%" name="tree" command="yazi" {
                close_on_exit true
            }
            pane split_direction="horizontal" {
                pane focus=true name="editor"
                pane size="25%" name="console"
            }
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}

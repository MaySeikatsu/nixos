// IDE layout + lazygit sidebar right (history/branches/staging).
// New tab in current session: `zideg`
layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="18%" name="tree" command="broot" {
                close_on_exit true
            }
            pane split_direction="horizontal" {
                pane focus=true name="editor"
                pane size="25%" name="console"
            }
            pane size="30%" name="git" command="lazygit" {
                close_on_exit true
            }
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}

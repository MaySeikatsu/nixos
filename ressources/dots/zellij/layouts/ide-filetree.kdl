// IDE layout - filetree only: broot tree sidebar (left) + editor. No console.
// New tab in current session: `zidef`
layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="20%" name="tree" command="broot" {
                close_on_exit true
            }
            pane focus=true name="editor"
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}
